# The API binds to localhost by default. Keep it local unless authentication is added.
VEA_HOST=127.0.0.1
VEA_PORT=8765

# Use JSON syntax. Replace these examples with folders that contain your footage.
VEA_ALLOWED_MEDIA_ROOTS=["~/Movies","~/Desktop","~/Downloads"]
VEA_DATA_DIR=~/.video-edit-automation

# Local dashboard origins allowed to call the localhost API.
VEA_DASHBOARD_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:4173","http://localhost:4173"]

# Optional mounted SMB/local drop folders containing session.json + recording + READY packages.
# Leave empty to disable automatic capture ingestion.
VEA_CAPTURE_INBOX_ROOTS=[]
VEA_CAPTURE_INBOX_POLL_SECONDS=15
VEA_CAPTURE_INBOX_AUTO_SCAN=true

VEA_FFMPEG_BINARY=ffmpeg
VEA_FFPROBE_BINARY=ffprobe
VEA_VIDEO_CODEC=libx264

# Local League VOD OCR/audio analyser.
VEA_TESSERACT_BINARY=tesseract
VEA_GAMING_ANALYSIS_AUDIO_PEAK_LIMIT=18
VEA_GAMING_ANALYSIS_CANDIDATE_RADIUS_SECONDS=4
VEA_GAMING_ANALYSIS_OCR_WORKERS=4
VEA_GAMING_ANALYSIS_TAIL_SECONDS=60
VEA_GAMING_ANALYSIS_TAIL_INTERVAL_SECONDS=2

# Optional local model server. Both LM Studio and Ollama can expose /v1/chat/completions.
# LM Studio is commonly http://127.0.0.1:1234/v1
# Ollama is commonly    http://127.0.0.1:11434/v1
VEA_LLM_BASE_URL=http://127.0.0.1:1234/v1
VEA_LLM_MODEL=
VEA_LLM_API_KEY=local
VEA_LLM_TIMEOUT_SECONDS=120

# Optional independent highlight reviewer. Point this at a multimodal OpenAI-compatible local
# model (LM Studio, Ollama, or a Hermes API gateway). Leave the model empty to disable it.
VEA_REVIEWER_BASE_URL=http://127.0.0.1:1234/v1
VEA_REVIEWER_MODEL=
VEA_REVIEWER_API_KEY=local
VEA_REVIEWER_TIMEOUT_SECONDS=120
VEA_REVIEWER_FRAME_WIDTH=640
